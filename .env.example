# Django
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
RENDER_EXTERNAL_HOSTNAME=

# MySQL Database (Aiven or any managed MySQL)
DB_NAME=examgenie_db
DB_USER=examgenie_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Path to Aiven's downloaded ca.pem (leave blank for local MySQL without SSL)
DB_SSL_CA=

# Payment Gateway (Razorpay example)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
PAPER_DOWNLOAD_PRICE=49.00

# Email (for notifications, optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
